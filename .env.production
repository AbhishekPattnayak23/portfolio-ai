# Production environment variables
VITE_API_BASE_URL=https://api.example.com
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Content Security Policy
# This is a fallback - ideally CSP should be set server-side
VITE_CSP_HEADER="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'"
